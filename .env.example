# ---- server ----
PORT=8080
APP_BASE_URL=http://localhost:8080
# Optional: serve the built SPA from this directory
# WEB_DIR=../frontend/dist

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=anyquery

# ---- authentication ----
# Local email/password login (bcrypt) and OIDC can coexist.
AUTH_PASSWORD_MODE=true
# Password assigned to the seeded demo admin by `mise run seed`.
DEMO_ADMIN_PASSWORD=anyquery-demo
# Development email-only login. Disable in production.
AUTH_DEV_MODE=true
SESSION_TTL_HOURS=168
# Secure cookies are inferred from an https APP_BASE_URL.
# COOKIE_SECURE=true

# Generic OIDC (authorization code + PKCE).
# OIDC_ISSUER=https://your-tenant.us.auth0.com/
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid,profile,email

# Required outside development mode (base64, 32 bytes).
# Generate: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# Extra browser origins allowed to make cookie-authenticated requests.
# APP_ALLOWED_ORIGINS=https://app.example.com

# ---- query limits ----
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_SOURCE_ROWS=100000
QUERY_MAX_RESULT_ROWS=10000

# ---- optional demo seeding (container entrypoint) ----
# SEED_DEMO=true
